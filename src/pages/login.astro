---
import Layout from "../layouts/Layout.astro";
import AccountModes from "../components/AccountModes.astro";
const demo = Astro.url.searchParams.get("mode") === "demo";
if (Astro.locals.actor)
  return Astro.redirect(Astro.locals.actor.kind === "convenor" ? Astro.locals.actor.convenor.purpose === "overload" ? "/overload/" : "/applications/" : "/plan/", 303);
---

<Layout title="Sign in" actor={null}>
  <div class="auth-card">
    <p class="eyebrow">COURSE ENROLMENT · PROTOTYPE</p>
    <h1>Welcome back</h1>
    <AccountModes page="login" demo={demo} />
    <p>Sign in to your saved courses and permission requests.</p>
    <p class="field-help">{demo ? "Use the @enrolment.test address you chose. Your password also lets you reopen a private inbox if you have not confirmed the account yet." : "Use the ANU email address you verified for this prototype, such as u1234567@anu.edu.au or your ANU email alias."}</p>
    <form method="post" action="/api/auth/login" class="stack">
      <input type="hidden" name="mode" value={demo ? "demo" : "normal"} />
      <label for="email">{demo ? "Demo email" : "ANU email"}</label>
      <input id="email" name="email" type="email" autocomplete="username" required maxlength="254" />
      <label for="password">Prototype password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        maxlength="128"
      />
      <button class="primary">Sign in</button>
    </form>
    <p><a href={`/forgot-password/${demo ? "?mode=demo" : ""}`}>Forgot password?</a></p>
    <p>
      New here? <a href={`/register/${demo ? "?mode=demo" : ""}`}>Create a student account</a>
    </p>
    {!demo && <details>
      <summary>Resend verification or invitation</summary>
      <form method="post" action="/api/auth/resend" class="stack">
        <label for="resend-email">ANU email</label>
        <input id="resend-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        <button>Resend verification</button>
      </form>
      <p class="muted">Resend is for accounts awaiting activation or an invited reviewer role. If you forgot your password, use <a href="/forgot-password/">Forgot password?</a>.</p>
    </details>}
    <p class="muted">Real reviewer access is invitation-only. One account can hold both views. <a href="/reviewer-access/">Reviewer access and demo</a>.</p>
  </div>
</Layout>
