---
import Layout from "../layouts/Layout.astro";
import { accountFor } from "../lib/email-checks";
import { invitationList, managesReviewers, pendingInvitation, reviewerSlots } from "../lib/reviewer-invitations";
const actor = Astro.locals.actor;
const account = actor ? accountFor(actor) : undefined;
const manager = managesReviewers(account);
const slots = manager ? reviewerSlots() : [];
const invitations = manager ? invitationList() : [];
const pending = account ? pendingInvitation(account.id) : undefined;
---
<Layout title="Reviewer access" actor={actor}>
  <h1>Reviewer access</h1>
  <p class="lede">Try both sides of enrolment, or accept an invitation to review assigned courses.</p>
  <p class="note"><strong>Reviewer access is by invitation.</strong> Registering creates a student account. Only the project owner can invite an account to become an assigned reviewer.</p>
  <section class="surface" aria-labelledby="demo-review-heading">
    <h2 id="demo-review-heading">Try demo reviewing</h2>
    <p>A demo student can review their own fictional permission and overload requests. Decisions are labelled as a simulation and affect only that demo profile.</p>
    {account?.kind === "demo" ? <a class="button primary" href="/reviewer-demo/">Open my demo reviewer view</a>
      : <p><a href="/register/?mode=demo">Create a demo student account</a>, then open its reviewer view. {actor && "Sign out first, or use a private browser window to keep this account open."}</p>}
  </section>
  <section class="surface" aria-labelledby="invited-review-heading">
    <h2 id="invited-review-heading">Invited reviewer access</h2>
    <p>Use one verified ANU email and password for both student and reviewer views. The project owner assigns a fictional reviewer and emails a personal invitation; public registration does not grant this role.</p>
    <p>An invited course reviewer can see other students’ requests sent to them for their assigned courses, including the explanation, eligibility evidence and timeline. They cannot browse other students’ profiles or requests outside that assignment. The separate program-load reviewer handles overload requests sent for review.</p>
    <p>Open the emailed link to accept. An existing verified account keeps its password and student record. New reviewers choose a password and can create a fictional student view after signing in.</p>
    {account?.convenorId ? <form method="post" action="/api/auth/switch-role">
      <input type="hidden" name="role" value={actor?.kind === "convenor" ? "student" : "reviewer"} />
      <button class="primary">{actor?.kind === "convenor" ? account.studentId ? "Switch to student view" : "Create my student view" : "Switch to reviewer view"}</button>
    </form> : <p>{pending ? "Your reviewer invitation is pending. Check your email; accepting it adds the role to this account." : "Ask the project owner to invite your ANU email. It can be the address you already use as a student."}</p>}
    {pending && <form method="post" action="/api/reviewer-access"><input type="hidden" name="action" value="resend" /><button>Resend my invitation</button></form>}
    <p>Links last 30 minutes. When signed out, <a href="/login/">resend verification or invitation from sign-in</a>. Automatic assessments do not enter a reviewer queue; students select Optional staff review → Send to convenor.</p>
  </section>
  {manager && <section class="surface" aria-labelledby="invite-heading" data-invitation-manager>
    <h2 id="invite-heading">Manage reviewer invitations</h2>
    <p>Your verified account manages invitations. You can invite your own address to test both views, or invite different people to different assignments. Each account can hold one reviewer assignment, and each assignment belongs to one account.</p>
    <form method="post" action="/api/reviewer-access" class="stack invitation-form">
      <input type="hidden" name="action" value="invite" />
      <label for="invite-email">Recipient ANU email</label>
      <input id="invite-email" name="email" type="email" autocomplete="email" required maxlength="254" />
      <fieldset class="reviewer-assignments" aria-describedby="assignment-help">
        <legend>Reviewer assignment</legend>
        <p id="assignment-help" class="field-help">Choose one assignment. All assigned courses are shown below. An assigned reviewer is unavailable; a pending invitation can be resent only to its existing recipient.</p>
        <div class="reviewer-grid">
          {slots.map(slot => <div class:list={["reviewer-option", { assigned: slot.assigned }]}>
            <div class="reviewer-option-heading">
              <input id={`reviewer-${slot.id}`} type="radio" name="convenorId" value={slot.id} required disabled={slot.assigned}
                aria-describedby={`reviewer-status-${slot.id} reviewer-scope-${slot.id}`} />
              <label for={`reviewer-${slot.id}`}>{slot.name}</label>
              <span id={`reviewer-status-${slot.id}`} class="reviewer-availability">{slot.assigned ? "Assigned" : slot.pending ? "Invitation pending" : "Available"}</span>
            </div>
            <div id={`reviewer-scope-${slot.id}`}>
              <p class="field-help">{slot.purpose === "overload" ? "Overload review across programs. Course permissions remain with the assigned course reviewer." : "Course permission requests"}</p>
              {slot.purpose !== "overload" && (slot.courses.length ? <ul class="reviewer-courses" aria-label={`Courses assigned to ${slot.name}`}>
                {slot.courses.map(code => <li>{code}</li>)}
              </ul> : <p class="field-help">No courses assigned.</p>)}
            </div>
          </div>)}
        </div>
      </fieldset>
      <button class="primary">Send reviewer invitation</button>
    </form>
    <h3>Invitation history</h3>
    {invitations.length ? <ul>{invitations.map(({ invitation, email, reviewer }) => <li>
      <p>{email} · {reviewer} · {invitation.status}</p>
      {invitation.status === "pending" && <form method="post" action="/api/reviewer-access">
        <input type="hidden" name="action" value="cancel" /><input type="hidden" name="invitationId" value={invitation.id} />
        <button>Cancel invitation for {reviewer}</button>
      </form>}
    </li>)}</ul> : <p>No invitations have been created yet.</p>}
  </section>}
</Layout>

<style>
  .surface + .surface { margin-top: 1.25rem; }
  .invitation-form { max-width: none; }
  #invite-email { max-width: 36rem; }
  .reviewer-assignments { border: 0; padding: 0; margin: 1rem 0 0; min-width: 0; }
  .reviewer-assignments legend { font-weight: 600; padding: 0; }
  .reviewer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1rem; }
  .reviewer-option { min-width: 0; padding: 1rem; border: 2px solid var(--line); border-radius: 3px; }
  .reviewer-option:has(input:checked) { border-color: var(--gold); background: #fbf8f0; }
  .reviewer-option.assigned { background: #f0eee9; }
  .reviewer-option-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 0.65rem; align-items: center; }
  .reviewer-option input { width: 1.15rem; height: 1.15rem; min-height: 0; margin: 0; accent-color: #654e20; }
  .reviewer-option label { display: flex; align-items: center; min-height: 44px; cursor: pointer; font-size: 1rem; }
  .assigned label { cursor: default; }
  .reviewer-availability { grid-column: 2; color: var(--muted); font-size: 0.875rem; }
  .reviewer-option .field-help { margin: 0.75rem 0 0.5rem; }
  .reviewer-courses { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.4rem 0.65rem; padding: 0; margin: 0; list-style: none; }
  .reviewer-courses li { font-size: 0.9rem; }
</style>
