---
import Layout from "../layouts/Layout.astro";
import { gateFor, listCourses, liveApplication, TERM_LABELS } from "../lib/store";
import type { Term } from "../data/courses";
import { ACTIVE_YEAR } from "../lib/academic-year";
const actor = Astro.locals.actor;
const isReviewer = actor?.kind === "convenor";
const query = Astro.url.searchParams.get("q") ?? "";
const subject = Astro.url.searchParams.get("subject") ?? "";
const year = Number(Astro.url.searchParams.get("year") ?? ACTIVE_YEAR);
const term = Astro.url.searchParams.get("term") ?? "";
const all = listCourses("", "", year);
const subjects = [...new Set(all.map(c => c.code.slice(0, 4)))];
const rows = listCourses(query, subject, year).filter((c) => !term || c.termList.includes(term as Term));
const badge = (course: (typeof rows)[number]) => {
  if (actor?.kind !== "student") return null;
  const selectedTerm = term || course.termList[0];
  if (!selectedTerm) return { text: "No published offering", tone: "muted" };
  const g = gateFor(actor.student, course.code, selectedTerm, year);
  if (g.outcome === "already")
    return { text: g.text.includes("passed") ? "Passed" : "Enrolled", tone: "muted" };
  const live = selectedTerm && liveApplication(actor.student.id, course.id, selectedTerm, year);
  if (live)
    return { text: live.status === "approved" ? "Permission approved" : "Under review", tone: "info" };
  return {
    text: {
      eligible: "Ready to enrol",
      "rules-not-met": "Permission needed",
      "permission-always": "Permission for everyone",
      "permission-conditional": "Permission in your circumstances",
      "not-recorded": "Eligibility check unavailable",
      "assessment-incomplete": "Assessment incomplete",
    }[g.outcome],
    tone: g.outcome === "eligible" ? "ok" : "muted",
  };
};
---

<Layout title={isReviewer ? "Course catalogue" : "Find courses"} actor={actor}>
  <div class="page-top">
    <div>
      <p class="eyebrow">{isReviewer ? "COURSE INFORMATION" : "PLAN YOUR STUDIES"} · {year}</p>
      <h1>{isReviewer ? "Course catalogue" : "Find your next course"}</h1>
      <p class="lede">{isReviewer ? "Browse published requirements and offerings. Manage student requests in your review queue." : "Explore courses, check requirements, and build your semester in one place."}</p>
    </div>
    {actor?.kind === "student" && (
      <a class="button" href="/plan/">
        View my courses →
      </a>
    )}
  </div>
  <form method="get" action="/" class="search" role="search">
    <input type="hidden" name="year" value={year} />
    <div>
      <label for="q">Course code or title</label>
      <input id="q" name="q" type="search" value={query} placeholder="COMP6528, 6528, or Computer Vision" />
    </div>
    <div>
      <label for="subject">Subject</label>
      <select id="subject" name="subject">
        <option value="">All subjects</option>
        {subjects.map((s) => (
          <option value={s} selected={subject === s}>
            {s}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label for="term">{year} term</label>
      <select id="term" name="term">
        <option value="" selected={!term}>
          All terms
        </option>
        {Object.entries(TERM_LABELS).map(([value, label]) => (
          <option value={value} selected={term === value}>
            {label}
          </option>
        ))}
      </select>
    </div>
    <button class="primary">Find courses</button>
  </form>
  <p class="muted">
    {rows.length} {rows.length === 1 ? "course" : "courses"}
    {term ? ` · ${TERM_LABELS[term as Term] ?? term} ${year}` : ` · ${year}, including courses without published offerings`}.{" "}
    {!actor && (
      <>
        <a href="/login/">Sign in</a> to check your fictional academic record and save courses.
      </>
    )}
  </p>
  {rows.length === 0 && (
    <div class="empty">
      <h2>No matching courses in this term</h2>
      <p>
        Try a different term or{" "}
        <a href={`/?q=${encodeURIComponent(query)}&subject=${encodeURIComponent(subject)}&term=&year=${year}`}>
          search across all terms
        </a>
        .
      </p>
    </div>
  )}
  <ul class="course-list">
    {rows.map((c) => {
      const b = badge(c);
      return (
        <li>
          <a
            href={`/courses/${c.code}/?term=${encodeURIComponent(term || c.termList[0] || "")}&year=${year}`}
            class="course-card"
          >
            <span class="code">{c.code}</span>
            <span class="title">{c.title}</span>
            <span class="meta">
              {c.unitsText} ·{" "}
              {c.termList.length ? c.termList.map((t) => TERM_LABELS[t]).join(", ") : "No offering recorded"}
            </span>
            {b && <span class={`badge badge-${b.tone}`}>{b.text}</span>}
          </a>
        </li>
      );
    })}
  </ul>
</Layout>
