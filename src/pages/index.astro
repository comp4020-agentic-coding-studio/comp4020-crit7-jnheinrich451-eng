---
import { REQUISITES } from "../data/requisites";
import Layout from "../layouts/Layout.astro";
import { gate } from "../lib/eligibility";
import { actorFrom, applicationsOfStudent, listCourses, recordOf, TERM_LABELS } from "../lib/store";

// The catalogue. For a student, every row carries its gate outcome, so the
// courses that need a permission code are visible before anyone opens one.
const actor = actorFrom(Astro.cookies.get("as")?.value);
const query = Astro.url.searchParams.get("q") ?? "";
const rows = listCourses(query);

const record = actor.kind === "student" ? recordOf(actor.student) : null;
const requests = actor.kind === "student" ? applicationsOfStudent(actor.student.id) : [];
const badge = (code: string): { label: string; tone: string } | null => {
  if (!record) return null;
  const open = requests.find((a) => a.course.code === code && ["with-convenor", "approved"].includes(a.status));
  if (open) return { label: open.status === "approved" ? "Code approved" : "Requested", tone: "info" };
  const g = gate(code, REQUISITES[code], record);
  switch (g.outcome) {
    case "eligible":
      return { label: "Enrol directly", tone: "ok" };
    case "rules-not-met":
      return { label: "Code needed", tone: "warn" };
    case "permission-always":
      return { label: "Code for everyone", tone: "always" };
    case "not-recorded":
      return { label: "Not recorded", tone: "muted" };
    case "already":
      return { label: g.text.includes("passed") ? "Passed" : "Enrolled", tone: "muted" };
  }
};
---

<Layout title="Courses" actor={actor}>
  <h1>Courses</h1>
  <p class="lede">
    {
      actor.kind === "student" ? (
        <>Every course shows whether you can enrol straight away or need a permission code, checked against your record.</>
      ) : (
        <>You're acting as a convenor. Switch to a student to see the gate, or go to your <a href="/applications/">request queue</a>.</>
      )
    }
  </p>

  <form method="get" action="/" class="search" role="search">
    <label for="q">Find a course</label>
    <input id="q" name="q" type="search" value={query} placeholder="Code or title, e.g. COMP8620 or vision" />
    <button>Search</button>
  </form>

  {query && <p class="muted">{rows.length} {rows.length === 1 ? "course matches" : "courses match"} “{query}”. <a href="/">Show all</a></p>}

  <ul class="course-list">
    {
      rows.map((c) => {
        const b = badge(c.code);
        return (
          <li>
            <a href={`/courses/${c.code}/`} class="course-card">
              <span class="code">{c.code}</span>
              <span class="title">{c.title}</span>
              <span class="meta">
                {c.units} units · {c.termList.length ? c.termList.map((t) => TERM_LABELS[t]).join(", ") : "no offering listed"}
              </span>
              {b && <span class={`badge badge-${b.tone}`}>{b.label}</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
