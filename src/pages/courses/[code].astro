---
import GatePanel from "../../components/GatePanel.astro";
import { ACTIVE_YEAR } from "../../lib/academic-year";
import { catalogueLink, catalogueEntries, referenceLink } from "../../lib/catalogue";
import type { Term } from "../../data/courses";
import Layout from "../../layouts/Layout.astro";
import { gateFor, getCourse, latestAssessment, liveApplication, offeringFor, selectionsOf, TERM_LABELS } from "../../lib/store";
const actor = Astro.locals.actor;
const year = Number(Astro.url.searchParams.get("year") ?? ACTIVE_YEAR);
const course = getCourse(Astro.params.code ?? "", year);
if (!course) return new Response("No such course", { status: 404 });
const rules = course.rules;
const evidence = course.source?.evidence;
const entries = catalogueEntries();
const term = Astro.url.searchParams.get("term") ?? course.termList[0] ?? "";
const offering = offeringFor(course.id, term, year);
const g = actor?.kind === "student" ? gateFor(actor.student, course.code, term, year) : null;
const live = actor?.kind === "student" ? liveApplication(actor.student.id, course.id, term, year) : undefined;
const previous = actor?.kind === "student" && !live ? latestAssessment(actor.student.id, course.id, term, year) : undefined;
const saved =
  actor?.kind === "student" && selectionsOf(actor.student.id).some((s) => s.offering.id === offering?.id);
---

<Layout title={`${course.code} ${course.title}`} actor={actor}>
  <p class="breadcrumb">
    <a href={`/?term=${encodeURIComponent(term)}&year=${year}`}>Find courses</a> / {course.code}
  </p>
  <p class="eyebrow">{course.code}</p>
  <h1>{course.title}</h1>
  <dl class="facts">
    <div>
      <dt>Credit</dt>
      <dd>{course.unitsText}</dd>
    </div>
    <div>
      <dt>Catalogue year</dt>
      <dd>{year}</dd>
    </div>
    <div>
      <dt>Recorded offerings</dt>
      <dd>
        {course.termList.length ? course.termList.map((t) => TERM_LABELS[t]).join(", ") : "None recorded"}
      </dd>
    </div>
  </dl>
  <div class="course-columns">
    <section aria-labelledby="information-heading">
      <h2 id="information-heading">Course information</h2>
      {course.conflicted && <p class="warning">Conflicting saved sources need review. Compare them in the course library; enrolment is unavailable until resolved.</p>}
      {evidence ? <>
        <p>{evidence.description}</p>
        {evidence.sections.map(section => <details>
          <summary>{section.title}</summary>
          {!section.present ? <p>This section is missing from the saved page. Its requirements are unknown.</p> :
            section.blocks.map(block => <p>{block.text.split(/(\b[A-Z]{4}\d{4}\b)/g).map(part => {
              const ref = block.references.find(r => r.code === part && r.year !== null);
              const link = ref ? referenceLink(ref, entries) : null;
              return link ? <a href={link}>{part}</a> : part;
            })}</p>)}
        </details>)}
        <p class="muted">Saved ANU Programs &amp; Courses information, {year}. Future offerings are indicative. Automated checks cover only explicitly interpreted rules; your academic record is fictional.</p>
        <p><a href={catalogueLink("course", course.code, year)}>Course library: sources, offering dates and related entries</a></p>
      </> : <details>
        <summary>Requisites and incompatibilities</summary>
        {rules ? <blockquote>{rules.text}</blockquote> : <p>Requirements have not been transcribed for this historical demo.</p>}
      </details>}
      <p>
        <a href={`https://programsandcourses.anu.edu.au/${year}/course/${course.code}`}>
          Read the full published course information ↗
        </a>
      </p>
      <details>
        <summary>Who reviews permission requests?</summary>
        <p>
          {course.convenor.name} is the fictional reviewer assigned to {course.code} in this prototype. The
          selected course determines where a request goes.
        </p>
      </details>
    </section>
    <div>
      {course.termList.length > 0 && <form method="get" class="stack surface">
        <input type="hidden" name="year" value={year} />
        <label for="term">Choose an offering</label>
        <select name="term" id="term">
          {course.termList.map((t: Term) => (
            <option value={t} selected={t === term}>
              {year} · {TERM_LABELS[t]}
            </option>
          ))}
        </select>
        <button>Update offering</button>
      </form>}
      {!offering ? (
        <p class="warning">{evidence?.availability === "explicit-none" ? "The saved page explicitly lists no current offerings." : "No usable offering is recorded for this year and term."} You can still read the course information.</p>
      ) : actor?.kind === "student" && g ? (
        <>
          <form action="/api/selections" method="post" class="surface">
            <input type="hidden" name="offeringId" value={offering.id} />
            <button class="primary" name="action" value="add">
              {saved ? "View in my semester" : "Add to my semester"}
            </button>
            <p class="field-help">Saving a course does not enrol you.</p>
          </form>
          <GatePanel course={course} gate={g} live={live} term={term} year={year} />
          {previous && <p><a href={`/applications/${previous.id}/`}>Read your latest assessment and next steps</a></p>}
        </>
      ) : (
        <div class="surface">
          <h2>{actor ? "Reviewer view" : "Make this part of your semester"}</h2>
          <p>
            {actor
              ? "Review requests for your assigned courses in your queue."
              : "Sign in to check your fictional academic record, save this offering, and request permission if needed."}
          </p>
          <a class="button primary" href={actor ? "/applications/" : "/login/"}>
            {actor ? "Open request queue" : "Sign in"}
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
