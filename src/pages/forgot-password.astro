---
import Layout from "../layouts/Layout.astro";
import AccountModes from "../components/AccountModes.astro";
import { accountFor } from "../lib/email-checks";
import { INBOX_COOKIE, inboxFor } from "../lib/demo-inbox";
const demo = Astro.url.searchParams.get("mode") === "demo";
const account = Astro.locals.actor ? accountFor(Astro.locals.actor) : undefined;
const inbox = inboxFor(Astro.cookies.get(INBOX_COOKIE)?.value);
const demoEmail = account?.kind === "demo" ? account.email : inbox?.email;
---
<Layout title="Forgot password" actor={Astro.locals.actor}>
  <div class="auth-card">
    <h1>Forgot password?</h1>
    <AccountModes page="forgot-password" demo={demo} />
    <p>{demo ? "Use your private demo inbox to choose a new password." : "Enter the ANU email address you verified for this prototype. We will email a reset link."} You do not need your old password.</p>
    <p>The link is your verification key. Open it, then enter and confirm your new password. It expires after 30 minutes and works once.</p>
    {demo && <p>A fictional address cannot receive real email. Recovery needs an open private inbox or a signed-in demo session in this browser.</p>}
    {demo && !demoEmail ? <p>No private demo inbox is available here. If you have lost both your password and inbox access, <a href="/register/?mode=demo">create a new demo account with a different address</a>. Knowing an address alone does not grant access to its saved data.</p> : <form method="post" action="/api/auth/password-reset" class="stack">
      <input type="hidden" name="mode" value={demo ? "demo" : "normal"} />
      <label for="email">{demo ? "Demo email" : "Verified ANU email"}</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value={demo ? demoEmail : account?.kind === "normal" ? account.email : ""} readonly={demo} />
      <button class="primary">{demo ? "Send reset link to my private inbox" : "Email me a reset link"}</button>
    </form>}
    {demo && demoEmail && <p><a href="/demo-inbox/">Open your private demo inbox</a></p>}
    <p>Your profile, requests and enrolments stay saved. Your password changes only after you submit the new password; that signs out all sessions for the account.</p>
    <p><a href={`/login/${demo ? "?mode=demo" : ""}`}>Back to sign in</a></p>
  </div>
</Layout>
