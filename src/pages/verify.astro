---
import Layout from "../layouts/Layout.astro";
import { verificationInfo } from "../lib/auth";
const token = Astro.url.searchParams.get("token") ?? "";
const info = verificationInfo(token);
const actor = Astro.locals.actor;
const currentName = actor?.kind === "student" ? actor.student.name : actor?.convenor.name;
---

<Layout title="Verify your email" actor={actor}>
  <div class="auth-card">
    <h1>{info?.purpose === "demo-verify" ? "Confirm your demo account" : info?.purpose === "reviewer-invite" ? "Accept reviewer invitation" : "Verify your email"}</h1>
    {info && actor ? (
      <section aria-labelledby="switch-account-heading" data-account-switch>
        <h2 id="switch-account-heading">Sign out to continue</h2>
        <p>You are signed in as <strong>{currentName}</strong> ({actor.kind === "student" ? "student" : "reviewer"}). This link verifies an account or adds invited reviewer access; it does not switch your current session.</p>
        <p>Sign out here to continue with this invitation or verification link. To keep both accounts open, use the link in a private browser window instead.</p>
        <form method="post" action="/api/auth/logout" class="stack">
          <input type="hidden" name="verificationToken" value={token} />
          <button class="primary">Sign out and continue</button>
        </form>
        <p><a href={actor.kind === "student" ? "/plan/" : "/applications/"}>Keep using my current account</a></p>
      </section>
    ) : info ? (
      <>
        <p>
          {info.purpose === "invite" || info.purpose === "reviewer-invite"
            ? info.needsPassword ? "Choose a password to activate your invited reviewer account." : "Accept the invited reviewer role on your existing account. Keep using your current password. Your student profile, requests and enrolments stay saved."
            : info.purpose === "demo-verify" ? "This is a simulated inbox confirmation. Continue to explore enrolment with your persistent fictional profile." : "Confirm to activate your student account."}
        </p>
        <form method="post" action="/api/auth/verify" class="stack">
          <input type="hidden" name="token" value={token} />
          {info.needsPassword && (
            <>
              <label for="password">Create a prototype password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="15"
                maxlength="128"
                required
              />
              <p class="field-help">15–128 characters. Do not reuse your ANU password.</p>
            </>
          )}
          <button class="primary">{info.purpose === "demo-verify" ? "Confirm & enter demo" : "Confirm email address"}</button>
        </form>
      </>
    ) : (
      <>
        <p>This link is invalid, expired, or already used.</p>
        {actor ? <section data-current-session>
          <p>You are still signed in as <strong>{currentName}</strong>. If you already activated the other account, sign out here and sign in with its email and password. Otherwise, request another verification email after signing out.</p>
          <form method="post" action="/api/auth/logout"><button>Sign out to use another account</button></form>
        </section> : <p><a href="/login/">Sign in or request another verification email</a>.</p>}
      </>
    )}
  </div>
</Layout>
