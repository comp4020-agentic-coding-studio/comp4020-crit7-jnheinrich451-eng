---
import Layout from "../layouts/Layout.astro";
import PendingRequestNotice from "../components/PendingRequestNotice.astro";
import ConfirmedEnrolments from "../components/ConfirmedEnrolments.astro";
import ScenarioCompletions from "../components/ScenarioCompletions.astro";
import StudyLoadSummary from "../components/StudyLoadSummary.astro";
import { studyLoadFor } from "../lib/overload-store";
import { applicationsOfStudent, enrolmentsOf, gateFor, offeringFor, selectionsOf, TERM_LABELS } from "../lib/store";
import { applicationStatus } from "../lib/application-status";
import type { Term } from "../data/courses";
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login/", 303);
if (actor.kind !== "student") return Astro.redirect("/applications/", 303);
const current = enrolmentsOf(actor.student.id);
const selected = selectionsOf(actor.student.id).filter(({ course, offering }) =>
  !current.some(e => e.code === course.code && e.year === offering.year && e.term === offering.term));
const requests = applicationsOfStudent(actor.student.id);
const scenarios = requests.filter(app => app.scenarioKey && app.enrolmentConfirmed);
---

<Layout title="My courses" actor={actor}>
  <div class="page-top">
    <div>
      <p class="eyebrow">SELECTIONS &amp; ENROLMENTS</p>
      <h1>My courses</h1>
      <p class="lede">
        Save courses to consider, track their requests, and confirm enrolment when ready.
        Your confirmed enrolments are listed separately below.
      </p>
    </div>
    <a class="button" href="/">
      Find another course
    </a>
  </div>
  <StudyLoadSummary studentId={actor.student.id} />
  <section aria-labelledby="saved-heading" data-saved-courses>
    <h2 id="saved-heading">Saved courses</h2>
    <p>These are courses you are considering. Saving one or submitting a request does not confirm enrolment.</p>
    {selected.length === 0 && <p class="muted">No saved courses awaiting enrolment. <a href="/">Find a course to save</a>.</p>}
    <div class="plan-list">
      {selected.map(({ course, offering }) => {
        const g = gateFor(actor.student, course.code, offering.term, offering.year);
        const matching = requests.filter(a => !a.scenarioKey && a.courseId === course.id && a.year === offering.year && a.term === offering.term);
        const live = matching.find(a => a.status === "with-convenor" || a.status === "approved");
        const request = live ?? matching[0];
        const progress = request ? applicationStatus(request) : null;
        const already = g.outcome === "already";
        const available = !!offeringFor(course.id, offering.term, offering.year);
        const load = studyLoadFor(actor.student.id, course.code, offering.year, offering.term);
        const loadBlocked = !already && load.state !== "within-limit";
        const ready = available && !already && !loadBlocked && (g.outcome === "eligible" || live?.status === "approved");
        const label = already
          ? g.text
          : !available ? "Offering unavailable" : loadBlocked ? load.state === "over-maximum" ? "Exceeds maximum load" : load.state === "unknown" ? "Load information needed" : "Overload approval needed" : ready
            ? "Ready to enrol"
            : progress
              ? progress.label
              : g.outcome === "not-recorded"
                ? "Eligibility check unavailable"
                : g.outcome === "assessment-incomplete" ? "Assessment incomplete"
                : "Permission needed";
        const href = `/courses/${course.code}/?term=${encodeURIComponent(offering.term)}&year=${offering.year}`;
        return (
          <article class="plan-row">
            <div>
              <span class="code">{course.code}</span>
              <h3>
                <a href={href}>{course.title}</a>
              </h3>
              <p class="meta">
                {offering.year} · {TERM_LABELS[offering.term as Term]} · {course.unitsText}
              </p>
            </div>
            <span class={`badge badge-${ready ? "ok" : "muted"}`}>{label}</span>
            {!already && <PendingRequestNotice request={live} />}
            {!ready && !already && request?.status === "assessment-incomplete" && <p class="assessment-summary">{progress?.say}</p>}
            <div class="actions">
              {available && loadBlocked && <a class="button" href={`/overload/?course=${course.code}&year=${offering.year}&term=${offering.term}`}>Review study load</a>}
              {ready && (
                <form method="post" action="/api/enrol">
                  <input type="hidden" name="courseCode" value={course.code} />
                  <input type="hidden" name="term" value={offering.term} />
                  <input type="hidden" name="year" value={offering.year} />
                  <button class="primary">Confirm enrolment</button>
                </form>
              )}
              {request && <a href={`/applications/${request.id}/`}>{request.report ? "View assessment and next steps" : "View permission request"}</a>}
              {!ready && !already && !live && (
                <a class="button" href={href}>
                  Review requirements
                </a>
              )}
              <form method="post" action="/api/selections">
                <input type="hidden" name="offeringId" value={offering.id} />
                <button name="action" value="remove">
                  Remove saved selection
                </button>
              </form>
            </div>
            <p class="field-help">
              Removing a saved selection does not cancel an enrolment or permission request.
            </p>
          </article>
        );
      })}
    </div>
  </section>
  <ConfirmedEnrolments enrolments={current} />
  <ScenarioCompletions completions={scenarios} />
</Layout>
