---
import Layout from "../../layouts/Layout.astro";
import PendingRequestNotice from "../../components/PendingRequestNotice.astro";
import { type ApplicationView, applicationsOfStudent, listCourses, queueOf, TERM_LABELS } from "../../lib/store";
import type { Term } from "../../data/courses";
import { applicationStatus } from "../../lib/application-status";
import { accountFor } from "../../lib/email-checks";

// A student's own requests, or a convenor's queue: only requests routed to
// them, waiting ones first. Auto-rejected requests never reached a person,
// so a convenor sees them only as a count.
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect("/login/", 303);
if (actor.kind === "convenor" && actor.convenor.purpose === "overload") return Astro.redirect("/overload/", 303);

let sections: { heading: string; empty: string; rows: ApplicationView[] }[];
let screened = 0;
if (actor.kind === "student") {
  sections = [
    {
      heading: "Your requests",
      empty: "You haven't submitted any enrolment requests.",
      rows: applicationsOfStudent(actor.student.id),
    },
  ];
} else {
  const all = queueOf(actor.convenor.id);
  screened = all.filter((a) => a.status === "auto-rejected").length;
  sections = [
    {
      heading: "Waiting for you",
      empty: "Nothing is waiting for you.",
      rows: all.filter((a) => a.status === "with-convenor"),
    },
    {
      heading: "Decided",
      empty: "You haven't decided any requests yet.",
      rows: all.filter((a) => ["approved", "rejected"].includes(a.status)),
    },
  ];
}
const title = actor.kind === "student" ? "My requests" : "Request queue";
const watch = actor.kind === "student" ? { studentId: actor.student.id } : { convenorId: actor.convenor.id };
const assignedCourses = actor.kind === "convenor" ? listCourses().filter(c => c.convenor.id === actor.convenor.id) : [];
const ownStudentId = actor.kind === "convenor" ? accountFor(actor)?.studentId : undefined;
---

<Layout title={title} actor={actor} watch={watch}>
  {actor.kind === "student" && <p><a href="/overload/">Study load and overload requests</a></p>}
  <h1>{title}</h1>
  {actor.kind === "convenor" ? (
    <p class="lede">
      Requests for your assigned courses, {actor.convenor.name}. Open a request to review its explanation and
      eligibility evidence.
      {screened > 0 && (
        <>
          {" "}
          The automatic first round turned away {screened} {screened === 1 ? "request" : "requests"} before
          they got here.
        </>
      )}
    </p>
  ) : (
    <p class="lede">
      Track your assessments and permission requests. You can keep planning and enrol in other ready courses while a request
      is under review.
    </p>
  )}

  {actor.kind === "convenor" && <details data-assigned-courses>
    <summary>Your assigned courses ({assignedCourses.length})</summary>
    <ul>{assignedCourses.map(course => <li><a href={`/courses/${course.code}/?year=${course.year}`}>{course.code} — {course.title}</a></li>)}</ul>
  </details>}
  {sections.map((s, i) => (
    <section aria-labelledby={`section-${i}`}>
      <h2 id={`section-${i}`}>{s.heading}</h2>
      {s.rows.length === 0 ? (
        <>
          <p class="muted">{s.empty}</p>
          {actor.kind === "convenor" && i === 0 && <p class="muted">Students can send an incomplete assessment using <strong>Send this request to reviewer</strong>, or choose <strong>Optional staff review → Send to convenor</strong> on the course page. An automatic assessment alone does not enter this queue.</p>}
        </>
      ) : (
        <ul class="request-list">
          {s.rows.map((a) => (
            <li>
              <a href={`/applications/${a.id}/`} class="request-card">
                <span class="code">{a.course.code}</span>
                <span class="title">
                  {actor.kind === "convenor" ? `${a.student.name} (${a.student.uid})` : a.course.title}
                </span>
                <span class="meta">
                  Request #{a.id} · {actor.kind === "convenor" && !accountFor({ kind: "student", student: a.student }) && "Seeded example · "}
                  {ownStudentId === a.studentId && "Your student profile · "}
                  {actor.kind === "convenor" && accountFor({ kind: "student", student: a.student })?.kind === "demo" && "Demo account · "}
                  {a.scenarioKey && "Fictional topic scenario · "}
                  {`${a.year} ${TERM_LABELS[a.term as Term]}`} · sent{" "}
                  {a.createdAt.slice(0, 16).replace("T", " ")} UTC
                </span>
                <span class={`badge status-${a.status}`}>{applicationStatus(a).label}</span>
              </a>
              {actor.kind === "student" && <PendingRequestNotice request={a} />}
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</Layout>
