---
import Layout from "../../layouts/Layout.astro";
import { actorFrom, type ApplicationView, applicationsOfStudent, queueOf, TERM_LABELS } from "../../lib/store";
import type { Term } from "../../data/courses";

// A student's own requests, or a convenor's queue: only requests routed to
// them, waiting ones first. Auto-rejected requests never reached a person,
// so a convenor sees them only as a count.
const actor = actorFrom(Astro.cookies.get("as")?.value);

const STATUS: Record<string, string> = {
  "auto-rejected": "Rejected automatically",
  "with-convenor": "With convenor",
  approved: "Approved",
  rejected: "Rejected by convenor",
};

let sections: { heading: string; empty: string; rows: ApplicationView[] }[];
let screened = 0;
if (actor.kind === "student") {
  sections = [{ heading: "Your requests", empty: "You haven't requested any permission codes.", rows: applicationsOfStudent(actor.student.id) }];
} else {
  const all = queueOf(actor.convenor.id);
  screened = all.filter((a) => a.status === "auto-rejected").length;
  sections = [
    { heading: "Waiting for you", empty: "Nothing is waiting for you.", rows: all.filter((a) => a.status === "with-convenor") },
    { heading: "Decided", empty: "You haven't decided any requests yet.", rows: all.filter((a) => ["approved", "rejected"].includes(a.status)) },
  ];
}
const title = actor.kind === "student" ? "My requests" : "Request queue";
const watch = actor.kind === "student" ? { studentId: actor.student.id } : { convenorId: actor.convenor.id };
---

<Layout title={title} actor={actor} watch={watch}>
  <h1>{title}</h1>
  {
    actor.kind === "convenor" ? (
      <p class="lede">
        Requests for the courses you convene, {actor.convenor.name}. Each one reached you because the student picked
        your course, not because of anything they typed.
        {screened > 0 && <> The automatic first round turned away {screened} {screened === 1 ? "request" : "requests"} before they got here.</>}
      </p>
    ) : (
      <p class="lede">Every request shows where it is and who has it. Nothing sits without a status.</p>
    )
  }

  {
    sections.map((s, i) => (
      <section aria-labelledby={`section-${i}`}>
        <h2 id={`section-${i}`}>{s.heading}</h2>
        {s.rows.length === 0 ? (
          <p class="muted">{s.empty}</p>
        ) : (
          <ul class="request-list">
            {s.rows.map((a) => (
              <li>
                <a href={`/applications/${a.id}/`} class="request-card">
                  <span class="code">{a.course.code}</span>
                  <span class="title">
                    {actor.kind === "convenor" ? `${a.student.name} (${a.student.uid})` : a.course.title}
                  </span>
                  <span class="meta">
                    {TERM_LABELS[a.term as Term]} · sent {a.createdAt.slice(0, 16).replace("T", " ")} UTC
                  </span>
                  <span class={`badge status-${a.status}`}>{STATUS[a.status]}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Layout>
