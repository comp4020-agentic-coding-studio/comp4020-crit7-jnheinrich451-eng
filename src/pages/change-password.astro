---
import Layout from "../layouts/Layout.astro";
import { passwordChangeInfo } from "../lib/password-changes";
const token = Astro.url.searchParams.get("token") ?? "";
const info = passwordChangeInfo(token);
---
<Layout title="Change password" actor={Astro.locals.actor}>
  <div class="auth-card">
    <h1>Change password</h1>
    {info ? <>
      <p>{info.kind === "demo" ? "This link is for a demo account." : "This link confirms access to the email address for the account that requested the change."} Choose a new prototype password below. You do not need your old password or a separate verification code.</p>
      <p>Your academic data stays saved. Completing the change signs out all sessions for that account, plus any account currently open in this browser.</p>
      <form method="post" action="/api/auth/password-change-confirm" class="stack">
        <input type="hidden" name="token" value={token} />
        <label for="password">New prototype password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="15" maxlength="128" aria-describedby="password-help" />
        <p id="password-help" class="field-help">15–128 characters. Choose a different password; do not reuse your ANU password.</p>
        <label for="confirmation">Confirm new password</label>
        <input id="confirmation" name="confirmation" type="password" autocomplete="new-password" required minlength="15" maxlength="128" />
        <button class="primary">Confirm password change</button>
      </form>
    </> : <>
      <p>This password link is invalid, expired, or already used.</p>
      <p>Your password changes only when you submit a valid confirmation. <a href="/forgot-password/">Request a fresh password reset link</a>.</p>
    </>}
  </div>
</Layout>
