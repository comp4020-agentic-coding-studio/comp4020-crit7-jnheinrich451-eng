---
import Layout from "../layouts/Layout.astro";
import AccountModes from "../components/AccountModes.astro";
if (Astro.locals.actor) return Astro.redirect("/plan/", 303);
const demo = Astro.url.searchParams.get("mode") === "demo";
---

<Layout title="Create an account" actor={null}>
  <div class="auth-card">
    <p class="eyebrow">COURSE ENROLMENT · PROTOTYPE</p>
    <h1>Create your account</h1>
    <AccountModes page="register" demo={demo} />
    <p>{demo ? "Choose your demo address and confirm it in a private inbox here. No real email account is needed." : "Verify your ANU email, then explore enrolment with a fictional academic profile."}</p>
    <form method="post" action="/api/auth/register" class="stack">
      <input type="hidden" name="mode" value={demo ? "demo" : "normal"} />
      <label for="name">Display name</label>
      <input id="name" name="name" autocomplete="name" maxlength="80" required />
      <label for="email">{demo ? "Choose a demo email" : "ANU email"}</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
        aria-describedby="email-help"
        placeholder={demo ? "your-choice@enrolment.test" : undefined}
      />
      <p id="email-help" class="field-help">
        {demo ? "Choose the part before @enrolment.test (up to 48 letters, numbers, dots, hyphens or underscores). Use a nickname and a password you can remember. Nothing is sent through email." : "Use your real ANU address, such as u1234567@anu.edu.au or your ANU email alias. We will email you a verification link to check ownership."}
      </p>
      <label for="password">Create a prototype password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="15"
        maxlength="128"
        required
        aria-describedby="password-help"
      />
      <p id="password-help" class="field-help">
        15–128 characters. Use a new password, not your ANU password.
      </p>
      <button class="primary">{demo ? "Create demo account & open inbox" : "Create account & send verification"}</button>
    </form>
    <p class="field-help">{demo ? "Demo reviewing is limited to requests from your own demo profile." : "Registration gives you student access. To review other students’ requests, you need a separate invitation from the project owner."} <a href="/reviewer-access/">About reviewer access</a></p>
    <p class="muted">
      Your generated program and grades are demonstration data. This is not ANU's enrolment service and does
      not access your university record.
    </p>
    <p>
      Already registered? <a href={`/login/${demo ? "?mode=demo" : ""}`}>Sign in</a>
    </p>
  </div>
</Layout>
