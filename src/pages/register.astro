---
import Layout from "../layouts/Layout.astro";
if (Astro.locals.actor) return Astro.redirect("/plan/", 303);
---

<Layout title="Create an account" actor={null}>
  <div class="auth-card">
    <p class="eyebrow">COURSE ENROLMENT · PROTOTYPE</p>
    <h1>Create your account</h1>
    <p>Verify your ANU email, then explore enrolment with a fictional academic profile.</p>
    <form method="post" action="/api/auth/register" class="stack">
      <label for="name">Display name</label>
      <input id="name" name="name" autocomplete="name" maxlength="80" required />
      <label for="email">ANU email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
        aria-describedby="email-help"
      />
      <p id="email-help" class="field-help">
        Must end in @anu.edu.au. We will email you a verification link.
      </p>
      <label for="password">Create a prototype password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="15"
        maxlength="128"
        required
        aria-describedby="password-help"
      />
      <p id="password-help" class="field-help">
        15–128 characters. Use a new password, not your ANU password.
      </p>
      <button class="primary">Create account &amp; send verification</button>
    </form>
    <p class="muted">
      Your generated program and grades are demonstration data. This is not ANU's enrolment service and does
      not access your university record.
    </p>
    <p>
      Already registered? <a href="/login/">Sign in</a>
    </p>
  </div>
</Layout>
