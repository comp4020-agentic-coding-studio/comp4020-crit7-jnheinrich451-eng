---
import type { Actor } from "../lib/store";
import "../styles.css";
interface Props {
  title: string;
  actor: Actor | null;
  watch?: { applicationId?: number; convenorId?: number; studentId?: number };
}
const { title, actor } = Astro.props;
const here = Astro.url.pathname;
const navLinks =
  actor?.kind === "convenor"
    ? [
        { href: "/applications/", label: "Review requests" },
        { href: "/", label: "Course catalogue" },
      ]
    : [
        { href: "/", label: "Find courses" },
        ...(actor
          ? [
              { href: "/plan/", label: "My semester" },
              { href: "/applications/", label: "My requests" },
              { href: "/record/", label: "My profile" },
            ]
          : []),
      ];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Course enrolment</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            A
          </span>
          <span>
            Course enrolment<small>ANU student project · independent prototype</small>
          </span>
        </a>
        <div class="account-menu">
          {actor ? (
            <>
              <span>{actor.kind === "student" ? actor.student.name : actor.convenor.name}</span>
              <form method="post" action="/api/auth/logout">
                <button>Sign out</button>
              </form>
            </>
          ) : (
            <>
              <a href="/login/">Sign in</a>
              <a class="button" href="/register/">
                Create account
              </a>
            </>
          )}
        </div>
      </div>
      <nav aria-label="site">
        {navLinks.map((l) => (
          <a href={l.href} aria-current={here === l.href ? "page" : undefined}>
            {l.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      {Astro.url.searchParams.get("error") && (
        <p class="flash flash-error" role="alert">
          {Astro.url.searchParams.get("error")}
        </p>
      )}
      {Astro.url.searchParams.get("ok") && (
        <p class="flash flash-ok" role="status">
          {Astro.url.searchParams.get("ok")}
        </p>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Independent enrolment prototype. Academic profiles and reviewers are fictional.{" "}
        <a href="/guide/">Help</a> · <a href="/readme/">About this project</a>
      </p>
    </footer>
  </body>
</html>
