---
import type { Actor } from "../lib/store";
import { accountFor } from "../lib/email-checks";
import "../styles.css";
interface Props {
  title: string;
  actor: Actor | null;
  watch?: { applicationId?: number; convenorId?: number; studentId?: number };
}
const { title, actor } = Astro.props;
const account = actor ? accountFor(actor) : undefined;
const demoAccount = account?.kind === "demo";
const here = Astro.url.pathname;
const navLinks =
  actor?.kind === "convenor"
    ? [
        { href: actor.convenor.purpose === "overload" ? "/overload/" : "/applications/", label: actor.convenor.purpose === "overload" ? "Review overloads" : "Review requests" },
        { href: "/", label: "Course catalogue" },
      ]
    : [
        { href: "/", label: "Find courses" },
        ...(actor
          ? [
              { href: "/plan/", label: "My courses" },
              { href: "/applications/", label: "My requests" },
              { href: "/record/", label: "My profile" },
              { href: "/overload/", label: "Study load" },
            ]
          : []),
      ];
navLinks.push({ href: "/catalogue/", label: "Course library" });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Course enrolment</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">
          <img class="brand-logo" src="/anu-primary-gold-white.svg" width="80" height="108" alt="Australian National University" />
          <span>
            Course enrolment<small>ANU student project · independent prototype</small>
          </span>
        </a>
        <div class="account-menu">
          {actor ? (
            <>
              <span>{actor.kind === "student" ? actor.student.name : actor.convenor.name}</span>
              <a href="/account/">My account</a>
              {account?.convenorId && <form method="post" action="/api/auth/switch-role">
                <input type="hidden" name="role" value={actor.kind === "student" ? "reviewer" : "student"} />
                <button>{actor.kind === "student" ? "Switch to reviewer view" : account.studentId ? "Switch to student view" : "Create my student view"}</button>
              </form>}
              <form method="post" action="/api/auth/logout">
                <button>Sign out</button>
              </form>
            </>
          ) : (
            <>
              <a href="/login/">Sign in</a>
              <a class="button" href="/register/">
                Create account
              </a>
            </>
          )}
        </div>
      </div>
      <nav aria-label="site">
        {navLinks.map((l) => (
          <a href={l.href} aria-current={here === l.href ? "page" : undefined}>
            {l.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      {demoAccount && <p class="note" data-demo-account><strong>Demo account</strong> · Your fictional profile and actions are saved. <a href="/demo-inbox/">Private demo inbox</a>. Human-review requests are visible to assigned prototype reviewers; use fictional details.</p>}
      {demoAccount && <p><a href={here === "/reviewer-demo/" ? "/plan/" : "/reviewer-demo/"}>{here === "/reviewer-demo/" ? "Back to my student view" : "Try reviewing my demo requests"}</a></p>}
      {Astro.url.searchParams.get("error") && (
        <p class="flash flash-error" role="alert">
          {Astro.url.searchParams.get("error")}
        </p>
      )}
      {Astro.url.searchParams.get("ok") && (
        <p class="flash flash-ok" role="status">
          {Astro.url.searchParams.get("ok")}
        </p>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Independent enrolment prototype. Academic profiles and reviewers are fictional.{" "}
        <a href="/guide/">Help</a> · <a href="/reviewer-access/">Reviewer access</a> · <a href="/readme/">About this project</a>
      </p>
    </footer>
  </body>
</html>
