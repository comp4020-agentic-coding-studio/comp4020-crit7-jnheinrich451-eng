---
import type { Term } from "../data/courses";
import { type ApplicationView, TERM_LABELS } from "../lib/store";
interface Props { completions: ApplicationView[] }
const { completions } = Astro.props;
---
<section class="enrolment-panel scenario-panel" aria-labelledby="scenarios-heading">
  <div class="section-title"><div><p class="eyebrow">Practice workflow</p><h2 id="scenarios-heading">Demo scenario completions</h2></div><span class="section-count">{completions.length}<span class="visually-hidden"> completed demos</span></span></div>
  <p>Completed practice examples, saved separately. They use <strong>0 units</strong> of your study load.</p>
  {completions.length > 0 ? <ul class="enrolled-list" data-scenario-completions>
    {completions.map(app => <li>
      <div><h3><a href={`/applications/${app.id}/`}><span class="enrolled-code">{app.course.code}</span> {app.course.title}</a></h3>
        <p class="meta">{`${app.year} ${TERM_LABELS[app.term as Term]}`} · Scenario enrolment confirmed</p></div>
    </li>)}
  </ul> : <p class="muted">No completed examples yet. <a href="/demo/">Try the permission workflow demo</a>.</p>}
</section>
