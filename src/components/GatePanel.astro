---
import { canRequestAssessment, checkStatus, firstRound, type Gate } from "../lib/eligibility";
import RequirementChecks from "./RequirementChecks.astro";
import PendingRequestNotice from "./PendingRequestNotice.astro";
import { REQUEST_REASONS } from "../lib/demo-assessment";
import type { Application } from "../lib/schema";
import { type CourseRow } from "../lib/store";
interface Props {
  course: CourseRow;
  gate: Gate;
  live?: Application;
  term: string;
  year: number;
}
const { course, gate, live, term, year } = Astro.props;
const checks = "checks" in gate ? gate.checks : [];
const canApply = !live && canRequestAssessment(gate);
const assessmentRequest = gate.outcome === "not-recorded" || gate.outcome === "assessment-incomplete";
const hasUnmet = checks.some(c => checkStatus(c) === "unmet");
const hasUnknown = checks.some(c => checkStatus(c) === "unknown");
const preview = canApply ? firstRound(course.code, gate) : null;
---

<section class="gate" aria-labelledby="gate-heading">
  {gate.outcome === "already" ? (
    <>
      <h2 id="gate-heading">{gate.text.includes("passed") ? "Already completed" : "Enrolled"}</h2>
      <p>{gate.text}</p>
    </>
  ) : live ? (
    <>
      <h2 id="gate-heading">{live.status === "approved" ? "Permission approved" : "Under review"}</h2>
      <p>
        {live.status === "approved"
          ? "Your permission is ready. Confirm enrolment when you are ready."
          : `Waiting for ${course.convenor.name}. You can keep planning your other courses.`}
      </p>
      <a href={`/applications/${live.id}/`}>View request and history</a>
      <PendingRequestNotice request={live} />
    </>
  ) : gate.outcome === "eligible" ? (
    <>
      <h2 id="gate-heading">You can enrol directly</h2>
      <p>Your fictional record meets the recorded requirements.</p>
    </>
  ) : gate.outcome === "rules-not-met" ? (
    <>
      <h2 id="gate-heading">Permission code needed</h2>
      <p>One or more requirements are not met by your fictional record.</p>
    </>
  ) : gate.outcome === "permission-conditional" ? (
    <>
      <h2 id="gate-heading">Permission required in your circumstances</h2>
      <p>{gate.permissionReason}</p>
      <p>{hasUnmet ? "Your fictional record also has unmet requirements." : hasUnknown ? "Some requirements remain unresolved." : "Your recorded prerequisites are met. Request permission before confirming enrolment."}</p>
    </>
  ) : gate.outcome === "permission-always" ? (
    <>
      <h2 id="gate-heading">Permission code required for all students</h2>
      <p>
        Every student needs approval for this course.{" "}
        {hasUnmet ? "Your fictional record also has unmet prerequisites." : hasUnknown
          ? checks.some(c => checkStatus(c) === "met")
            ? "The recorded base prerequisites are met. Additional conditions remain unknown."
            : "Some prerequisite conditions remain unknown."
          : gate.requisitesMet
          ? gate.reviewNote ? "The recorded base prerequisites are met." : "The recorded prerequisites are met."
          : "The assessment is incomplete."}
      </p>
      {gate.reviewNote && <p>{gate.reviewNote}</p>}
    </>
  ) : gate.outcome === "assessment-incomplete" ? (
    <>
      <h2 id="gate-heading">Assessment incomplete</h2>
      <p>Some conditions cannot be checked from the available evidence. The missing items are listed below.</p>
    </>
  ) : (
    <>
      <h2 id="gate-heading">Automatic eligibility check unavailable</h2>
      <p>The published requirements need interpretation. You can request an assessment for this offering; unknown eligibility does not mean you have failed a prerequisite.</p>
    </>
  )}
  {checks.length > 0 && (
    <details open={hasUnmet || hasUnknown}>
      <summary>How your record compares</summary>
      <RequirementChecks checks={checks} />
    </details>
  )}
  {gate.outcome !== "already" && (gate.outcome === "eligible" || live?.status === "approved") && (
    <form method="post" action="/api/enrol" class="stack">
      <input type="hidden" name="courseCode" value={course.code} />
      <input type="hidden" name="term" value={term} />
      <input type="hidden" name="year" value={year} />
      <p>Confirming adds this offering to your prototype enrolments.</p>
      <button class="primary">Confirm enrolment</button>
    </form>
  )}
  {canApply && (
    <form method="post" action="/api/applications" class="stack apply">
      <h3>{assessmentRequest ? "Request assessment" : "Request permission"}</h3>
      <p class="field-help">Get an immediate demo assessment with the evidence and next steps. Missing evidence stays unresolved; this policy cannot grant exceptions or make ANU decisions.</p>
      {preview?.decision === "auto-reject" && (
        <div class="warning">
          <p>These recorded conditions prevent automatic permission:</p>
          <ul>
            {preview.reasons.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
          <p>If your record is incorrect, select that reason below. The result will identify the evidence needed to resolve it.</p>
        </div>
      )}
      <input type="hidden" name="courseCode" value={course.code} />
      <input type="hidden" name="term" value={term} />
      <input type="hidden" name="year" value={year} />
      <label for="reason">What should be assessed?</label>
      <select id="reason" name="reason">
        {Object.entries(REQUEST_REASONS).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label for="statement">Explain your request</label>
      <textarea id="statement" name="statement" rows="4" required maxlength="2000" />
      <p class="field-help">Your explanation is saved as self-reported context. It cannot create a pass, an equivalence or permission. Select the matching reason above if you dispute the record or need an exception.</p>
      <button class="primary" name="reviewMode" value="automatic">Get demo assessment</button>
      <details>
        <summary>Optional staff review</summary>
        <p>This sends the request to {course.convenor.name}, the fictional reviewer. The queue is not staffed automatically and may remain pending.</p>
        <button name="reviewMode" value="convenor">Send to convenor</button>
      </details>
    </form>
  )}
  {course.code === "COMP8620" && year === 2027 && <p><a href="/demo/">Try the complete workflow with a fictional topic and record</a></p>}
</section>
