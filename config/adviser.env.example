# Optional, server-side Ollama service. No model call occurs without this URL.
# A host development server can use http://127.0.0.1:11434.
# The local Docker compose preview uses http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# On Fly, localhost is the Fly machine, not your Windows PC.
# Leave unset until a private reachable Ollama service has been configured.
