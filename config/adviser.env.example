# Optional, server-side Ollama service. No model call occurs without this URL.
# A host development server can use http://127.0.0.1:11434.
# The local Docker compose preview uses http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional for a private HTTPS proxy such as Tailscale Serve. This is the HTTP
# Host header, NOT Ollama's OLLAMA_HOST listener setting. TLS still checks the
# hostname in OLLAMA_BASE_URL. Leave empty for ordinary direct connections.
OLLAMA_HOST_HEADER=
# Tailscale example (both machines must have tailnet access):
# OLLAMA_BASE_URL=https://your-server.your-tailnet.ts.net
# OLLAMA_HOST_HEADER=localhost:11434
# On Fly, localhost is the Fly machine, not your Windows PC.
# Leave unset until a private reachable Ollama service has been configured.
