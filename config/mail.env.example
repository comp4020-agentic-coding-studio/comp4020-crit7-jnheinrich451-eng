# Copy to the gitignored .env and replace the values locally.
# Supply these as runtime environment variables, never public frontend values.
APP_ORIGIN=https://your-app.fly.dev
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=replace-locally
SMTP_PASSWORD=replace-locally
MAIL_FROM=Enrolment prototype <verified-sender@your-domain.example>
